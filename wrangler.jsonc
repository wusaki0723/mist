{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "claude-oauth-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	// Optional: run near Singapore; this does not pin the egress IP.
	// "placement": { "region": "aws:ap-southeast-1" },
	// Secrets (set via `wrangler secret put`):
	// - PROXY_API_KEY       client-facing key for Hana / Claude Code / scripts
	// - CLAUDE_OAUTH_TOKEN  sk-ant-oat01-... from `claude setup-token` (valid ~1 year)
	// - ANTHROPIC_API_KEY   sk-ant-api03-... official key, used when no OAuth token set
	// Optional:
	// - CLOAK               "false" to forward bodies and client headers without compatibility defaults
	// - CLIENT_UA           override the default client UA when the built-in one ages
}
